generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @unique
  category           String?
  status             UserStatus           @default(ACTIVE)
  isActive           Boolean              @default(true) @map("is_active")
  isDeleted          Boolean              @default(false) @map("is_deleted")
  deletedAt          DateTime?            @map("deleted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  ownerUserId        String?              @unique @map("owner_user_id") @db.Uuid
  activities         Activity[]
  attributionTouches AttributionTouch[]
  billingCustomers   BillingCustomer[]
  owner              User?                @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  contactIdentities  ContactIdentity[]
  contacts           Contact[]
  Conversation       Conversation[]
  deals              Deal[]
  documents          Document[]
  finances           Finance[]
  follow_ups         follow_ups[]
  IntegrationAsset   IntegrationAsset[]
  integrations       Integration[]
  invoices           Invoice[]
  assignmentRules    LeadAssignmentRule[]
  leadAssignments    LeadAssignment[]
  leadPayments       LeadPayment[]
  leadStatusHistory  LeadStatusHistory[]
  leads              Lead[]
  Message            Message[]
  payments           Payment[]
  subscriptionEvents SubscriptionEvent[]
  subscription       Subscription?
  teams              Team[]
  usageCounters      UsageCounter[]
  usageEvents        UsageEvent[]
  userTeams          UserTeam[]
  users              User[]

  @@map("companies")
}

model User {
  id                                 String                            @id @default(uuid()) @db.Uuid
  email                              String                            @unique
  name                               String
  passwordHash                       String                            @map("password_hash")
  role                               Role                              @default(USER)
  status                             UserStatus                        @default(ACTIVE)
  company                            String?
  companyId                          String?                           @map("company_id") @db.Uuid
  phone                              String?
  department                         String?
  category                           String?
  avatarUrl                          String?                           @map("avatar_url")
  isActive                           Boolean                           @default(true) @map("is_active")
  isDeleted                          Boolean                           @default(false) @map("is_deleted")
  deletedAt                          DateTime?                         @map("deleted_at")
  modules                            Json?
  createdBy                          String?                           @map("created_by")
  lastLogin                          DateTime?                         @map("last_login")
  createdAt                          DateTime                          @default(now()) @map("created_at")
  updatedAt                          DateTime                          @updatedAt @map("updated_at")
  activities                         Activity[]
  ownedCompany                       Company?                          @relation("CompanyOwner")
  conversations_assigned             Conversation[]                    @relation("ConversationAssignedUser")
  deals                              Deal[]
  documents                          Document[]
  follow_ups                         follow_ups[]
  statusHistories                    LeadStatusHistory[]
  leads                              Lead[]
  messages_sent                      Message[]                         @relation("MessageSenderUser")
  sessions                           Session[]
  subscription_entitlement_overrides SubscriptionEntitlementOverride[]
  subscription_events                SubscriptionEvent[]
  usage_events                       UsageEvent[]
  teams                              UserTeam[]
  companyRef                         Company?                          @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@map("users")
}

model Contact {
  id                      String                    @id @default(uuid()) @db.Uuid
  companyId               String                    @map("company_id") @db.Uuid
  name                    String
  email                   String?
  phone                   String?
  companyName             String?                   @map("company_name")
  jobTitle                String?                   @map("job_title")
  city                    String?
  state                   String?
  country                 String?
  postalCode              String?                   @map("postal_code")
  customFields            Json?                     @map("custom_fields")
  isDeleted               Boolean                   @default(false) @map("is_deleted")
  deletedAt               DateTime?                 @map("deleted_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  normalizedEmail         String?                   @map("normalized_email")
  normalizedPhone         String?                   @map("normalized_phone")
  attributionTouches      AttributionTouch[]
  identities              ContactIdentity[]
  companyRef              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ConversationParticipant ConversationParticipant[]
  Conversation            Conversation[]
  leads                   Lead[]
  Message                 Message[]

  @@unique([companyId, normalizedEmail])
  @@unique([companyId, normalizedPhone])
  @@index([companyId, phone])
  @@index([companyId])
  @@map("contacts")
}

model ContactIdentity {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  contactId     String              @map("contact_id") @db.Uuid
  provider      String
  integrationId String?             @map("integration_id") @db.Uuid
  externalId    String              @map("external_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  identityType  ContactIdentityType @default(PROVIDER_EXTERNAL_ID) @map("identity_type")
  metadata      Json?
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, externalId])
  @@index([contactId])
  @@map("contact_identities")
}

model Lead {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  name               String
  email              String?
  phone              String?
  company            String?
  status             LeadStatus          @default(NEW)
  source             LeadSource?
  priority           Priority            @default(MEDIUM)
  value              Decimal?            @db.Decimal(14, 2)
  notes              String?
  userId             String              @map("user_id") @db.Uuid
  isDeleted          Boolean             @default(false) @map("is_deleted")
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  adId               String?             @map("ad_id")
  adSetId            String?             @map("ad_set_id")
  campaignId         String?             @map("campaign_id")
  contactId          String?             @map("contact_id") @db.Uuid
  creativeId         String?             @map("creative_id")
  externalLeadId     String?             @map("external_lead_id")
  formId             String?             @map("form_id")
  integrationId      String?             @map("integration_id") @db.Uuid
  pageId             String?             @map("page_id")
  sourcePlatform     String?             @map("source_platform")
  utmCampaign        String?             @map("utm_campaign")
  utmContent         String?             @map("utm_content")
  utmMedium          String?             @map("utm_medium")
  utmSource          String?             @map("utm_source")
  utmTerm            String?             @map("utm_term")
  conversionTouchId  String?             @map("conversion_touch_id") @db.Uuid
  firstTouchId       String?             @map("first_touch_id") @db.Uuid
  lastTouchId        String?             @map("last_touch_id") @db.Uuid
  activities         Activity[]
  attributionTouches AttributionTouch[]  @relation("LeadTouches")
  deals              Deal[]
  follow_ups         follow_ups[]
  assignments        LeadAssignment[]
  payments           LeadPayment[]
  statusHistory      LeadStatusHistory[]
  companyRef         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact            Contact?            @relation(fields: [contactId], references: [id])
  conversionTouch    AttributionTouch?   @relation("LeadConversionTouch", fields: [conversionTouchId], references: [id])
  firstTouch         AttributionTouch?   @relation("LeadFirstTouch", fields: [firstTouchId], references: [id])
  lastTouch          AttributionTouch?   @relation("LeadLastTouch", fields: [lastTouchId], references: [id])
  user               User                @relation(fields: [userId], references: [id])

  @@unique([companyId, email])
  @@unique([companyId, integrationId, externalLeadId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([userId])
  @@index([contactId])
  @@map("leads")
}

model AttributionTouch {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  contactId            String?               @map("contact_id") @db.Uuid
  leadId               String?               @map("lead_id") @db.Uuid
  integrationId        String?               @map("integration_id") @db.Uuid
  platform             AttributionPlatform   @default(UNKNOWN)
  channel              AttributionChannel    @default(UNKNOWN)
  sourceType           AttributionSourceType @default(UNKNOWN)
  campaignId           String?               @map("campaign_id")
  campaignName         String?               @map("campaign_name")
  adSetId              String?               @map("ad_set_id")
  adSetName            String?               @map("ad_set_name")
  adId                 String?               @map("ad_id")
  adName               String?               @map("ad_name")
  creativeId           String?               @map("creative_id")
  creativeName         String?               @map("creative_name")
  formId               String?               @map("form_id")
  formName             String?               @map("form_name")
  externalEventId      String?               @map("external_event_id")
  landingPage          String?               @map("landing_page")
  referrer             String?               @map("referrer")
  utmSource            String?               @map("utm_source")
  utmMedium            String?               @map("utm_medium")
  utmCampaign          String?               @map("utm_campaign")
  utmTerm              String?               @map("utm_term")
  utmContent           String?               @map("utm_content")
  capturedAt           DateTime              @default(now()) @map("captured_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact              Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead                 Lead?                 @relation("LeadTouches", fields: [leadId], references: [id], onDelete: Cascade)
  leadsConversionTouch Lead[]                @relation("LeadConversionTouch")
  leadsFirstTouch      Lead[]                @relation("LeadFirstTouch")
  leadsLastTouch       Lead[]                @relation("LeadLastTouch")

  @@unique([companyId, platform, externalEventId])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([campaignId])
  @@map("attribution_touches")
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  leadId            String?    @map("lead_id") @db.Uuid
  name              String
  value             Decimal    @db.Decimal(14, 2)
  stage             DealStage  @default(NEW_OPPORTUNITY)
  probability       Int?
  expectedCloseDate DateTime?  @map("expected_close_date")
  notes             String?
  userId            String     @map("user_id") @db.Uuid
  is_deleted        Boolean    @default(false)
  deleted_at        DateTime?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  activities        Activity[]
  companyRef        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead?      @relation(fields: [leadId], references: [id])
  user              User       @relation(fields: [userId], references: [id])
  documents         Document[]
  finances          Finance[]

  @@index([companyId])
  @@index([companyId, stage])
  @@index([leadId])
  @@index([userId])
  @@map("deals")
}

model Activity {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  leadId          String?             @map("lead_id") @db.Uuid
  dealId          String?             @map("deal_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  type            ActivityType
  subject         String?
  description     String?
  due_date        DateTime?
  completed_at    DateTime?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  companyRef      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal            Deal?               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead            Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id])
  statusHistories LeadStatusHistory[]

  @@index([companyId])
  @@index([companyId, type])
  @@index([dealId])
  @@index([leadId])
  @@index([userId])
  @@map("activities")
}

model LeadStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  leadId     String      @map("lead_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  activityId String?     @map("activity_id") @db.Uuid
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus  @map("to_status")
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  activity   Activity?   @relation(fields: [activityId], references: [id])
  companyRef Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([leadId])
  @@index([userId])
  @@map("lead_status_histories")
}

model LeadPayment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  companyRef  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@map("lead_payments")
}

model Finance {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  dealId      String?     @map("deal_id") @db.Uuid
  type        FinanceType
  amount      Decimal     @db.Decimal(14, 2)
  description String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  companyRef  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal        Deal?       @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@index([companyId])
  @@index([companyId, type])
  @@map("finances")
}

model Offer {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  content     Json?
  status      String?
  created_by  String?  @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("offers")
}

model Document {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  dealId     String?      @map("deal_id") @db.Uuid
  uploadedBy String       @map("uploaded_by") @db.Uuid
  name       String
  type       DocumentType
  url        String
  size       Int?
  mime_type  String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  companyRef Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal       Deal?        @relation(fields: [dealId], references: [id])
  uploader   User         @relation(fields: [uploadedBy], references: [id])

  @@index([dealId])
  @@index([companyId])
  @@index([uploadedBy])
  @@map("documents")
}

model EodReport {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?  @db.Uuid
  report_date DateTime
  content     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updated_at  DateTime

  @@map("eod_reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String
  entity     String?
  entity_id  String?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  user_agent String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entity, entity_id])
  @@index([user_id])
  @@map("audit_logs")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String?   @db.Uuid
  token_hash String
  expiresAt  DateTime  @map("expires_at")
  used_at    DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([user_id])
  @@map("password_reset_tokens")
}

model SystemConfig {
  id         String   @id @db.Uuid
  key        String
  value      Json?
  created_at DateTime @default(now())
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("system_configs")
}

model InvitationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @map("token_hash")
  email     String
  userId    String?   @map("user_id") @db.Uuid
  companyId String?   @map("company_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([expiresAt])
  @@index([email])
  @@index([userId])
  @@map("invitation_tokens")
}

model ActiveSession {
  userId     String   @id @map("user_id") @db.Uuid
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@map("active_sessions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  metadata         Json?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Plan {
  id                                                              String              @id @default(uuid()) @db.Uuid
  code                                                            String              @unique
  name                                                            String
  description                                                     String?
  planType                                                        PlanType            @default(STANDARD) @map("plan_type")
  status                                                          PlanStatus          @default(ACTIVE)
  displayOrder                                                    Int                 @default(0) @map("display_order")
  isPublic                                                        Boolean             @default(true) @map("is_public")
  isDefault                                                       Boolean             @default(false) @map("is_default")
  trialDays                                                       Int                 @default(0) @map("trial_days")
  billingInterval                                                 BillingInterval     @default(MONTH) @map("billing_interval")
  billingIntervalCount                                            Int                 @default(1) @map("billing_interval_count")
  currency                                                        String              @db.Char(3)
  basePrice                                                       Decimal             @map("base_price") @db.Decimal(14, 2)
  metadata                                                        Json?
  createdAt                                                       DateTime            @default(now()) @map("created_at")
  updatedAt                                                       DateTime            @updatedAt @map("updated_at")
  archivedAt                                                      DateTime?           @map("archived_at")
  billingPrices                                                   BillingPrice[]
  features                                                        PlanFeature[]
  prices                                                          PlanPrice[]
  subscription_events_subscription_events_new_plan_idToplans      SubscriptionEvent[] @relation("subscription_events_new_plan_idToplans")
  subscription_events_subscription_events_previous_plan_idToplans SubscriptionEvent[] @relation("subscription_events_previous_plan_idToplans")
  subscriptions                                                   Subscription[]
  scheduledSubscriptions                                          Subscription[]      @relation("ScheduledPlan")

  @@index([status, displayOrder])
  @@map("plans")
}

model PlanPrice {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId           String              @map("plan_id") @db.Uuid
  billingInterval  BillingInterval     @map("billing_interval")
  intervalCount    Int                 @default(1) @map("interval_count")
  currency         String              @db.Char(3)
  amount           Decimal             @db.Decimal(14, 2)
  originalAmount   Decimal?            @map("original_amount") @db.Decimal(14, 2)
  discountAmount   Decimal?            @map("discount_amount") @db.Decimal(14, 2)
  discountPercent  Decimal?            @map("discount_percent") @db.Decimal(5, 2)
  isActive         Boolean             @default(true) @map("is_active")
  isDefault        Boolean             @default(false) @map("is_default")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  code             String              @unique @db.VarChar(100)
  version          Int                 @default(1)
  trailingDays     Int                 @default(0) @map("trailing_days")
  plan             Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  eventsAsNew      SubscriptionEvent[] @relation("NewPlanPrice")
  eventsAsPrevious SubscriptionEvent[] @relation("PreviousPlanPrice")
  subscriptions    Subscription[]

  @@index([planId, billingInterval])
  @@index([planId])
  @@index([isActive])
  @@map("plan_prices")
}

model Feature {
  id                   String                            @id @default(uuid()) @db.Uuid
  code                 String                            @unique
  name                 String
  description          String?
  featureType          FeatureType                       @map("feature_type")
  status               FeatureStatus                     @default(ACTIVE)
  module               String?
  resource             String?
  action               String?
  isMetered            Boolean                           @default(false) @map("is_metered")
  isSystem             Boolean                           @default(false) @map("is_system")
  isVisible            Boolean                           @default(true) @map("is_visible")
  configurationSchema  Json?                             @map("configuration_schema")
  metadata             Json?
  createdAt            DateTime                          @default(now()) @map("created_at")
  updatedAt            DateTime                          @updatedAt @map("updated_at")
  archivedAt           DateTime?                         @map("archived_at")
  billingPrices        BillingPrice[]
  plans                PlanFeature[]
  entitlementOverrides SubscriptionEntitlementOverride[]
  subscriptionItems    SubscriptionItem[]
  usageCounters        UsageCounter[]
  usageEvents          UsageEvent[]

  @@index([status])
  @@index([module])
  @@map("features")
}

model PlanFeature {
  id            String     @id @default(uuid()) @db.Uuid
  planId        String     @map("plan_id") @db.Uuid
  featureId     String     @map("feature_id") @db.Uuid
  enabled       Boolean    @default(true)
  limitValue    BigInt?    @map("limit_value")
  limitType     LimitType? @map("limit_type")
  configuration Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  feature       Feature    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan          Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Subscription {
  id                     String                            @id @default(uuid()) @db.Uuid
  companyId              String                            @unique @map("company_id") @db.Uuid
  planId                 String                            @map("plan_id") @db.Uuid
  status                 SubscriptionStatus                @default(TRIALING)
  startedAt              DateTime?                         @map("started_at")
  trial_starts_at        DateTime?
  trialEndsAt            DateTime?                         @map("trial_ends_at")
  currentPeriodStart     DateTime?                         @map("current_period_start")
  currentPeriodEnd       DateTime?                         @map("current_period_end")
  canceledAt             DateTime?                         @map("canceled_at")
  cancelAtPeriodEnd      Boolean                           @default(false) @map("cancel_at_period_end")
  scheduledPlanId        String?                           @map("scheduled_plan_id") @db.Uuid
  scheduledChangeAt      DateTime?                         @map("scheduled_change_at")
  currency               String                            @db.Char(3)
  amount                 Decimal                           @db.Decimal(14, 2)
  quantity               Int                               @default(1)
  provider               BillingProvider?
  providerSubscriptionId String?                           @map("provider_subscription_id")
  version                BigInt                            @default(1)
  metadata               Json?
  createdAt              DateTime                          @default(now()) @map("created_at")
  updatedAt              DateTime                          @updatedAt @map("updated_at")
  billingInterval        BillingInterval?                  @map("billing_interval")
  planPriceId            String?                           @map("plan_price_id") @db.Uuid
  billingSubscription    BillingSubscription?
  invoices               Invoice[]
