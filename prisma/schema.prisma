// NEXUS Sales CRM — Prisma Schema
// 9 tables, 12 enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  HOLD
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  COLD_CALL
  COLD_EMAIL
  ADVERTISING
  EVENT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DealStage {
  NEW_OPPORTUNITY
  DISCOVERY_SCHEDULED
  DISCOVERY_COMPLETED
  PROPOSAL_PREP
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_SENT
  CONTRACT_SIGNED
  PROJECT_KICKOFF
  ON_HOLD
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  FOLLOW_UP
}

enum FollowUpType {
  CALL
  EMAIL
  SMS
  LINKEDIN
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SKIPPED
  OVERDUE
}

enum FinanceType {
  CASH_IN
  CASH_OUT
  RECEIVABLE
}

enum DocumentType {
  PROPOSAL
  CONTRACT
  INVOICE
  OTHER
}

// ─── Models ──────────────────────────────────────────────

model Company {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  category  String?
  status    UserStatus @default(ACTIVE)
  isActive  Boolean    @default(true) @map("is_active")
  isDeleted Boolean    @default(false) @map("is_deleted")
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users     User[]

  @@map("companies")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique
  name          String
  passwordHash  String      @map("password_hash")
  plainPassword String?     @map("plain_password")
  role          Role        @default(USER)
  status        UserStatus  @default(ACTIVE)
  company       String?
  companyId     String?     @map("company_id") @db.Uuid
  phone         String?
  department    String?
  category      String?
  avatarUrl     String?     @map("avatar_url")
  isActive      Boolean     @default(true) @map("is_active")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  deletedAt     DateTime?   @map("deleted_at")
  modules       Json?       // array of permitted module names
  createdBy     String?     @map("created_by")  // admin user id who created this user
  lastLogin     DateTime?   @map("last_login")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  companyRef    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  deals         Deal[]
  activities    Activity[]
  documents     Document[]
  statusHistories LeadStatusHistory[]
  invitationTokens InvitationToken[]

  @@map("users")
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String?    @unique
  phone           String?
  company         String?
  jobTitle        String?    @map("job_title")
  linkedinUrl     String?    @map("linkedin_url")
  companyWebsite  String?    @map("company_website")
  category        String?
  location        String?
  interestedProduct String?  @map("interested_product")
  status          LeadStatus @default(NEW)
  leadSource      LeadSource? @map("lead_source")
  leadType        String?    @map("lead_type")
  priority        Priority   @default(MEDIUM)
  score           Int        @default(0) @db.SmallInt
  engagementScore Int        @default(0) @map("engagement_score") @db.SmallInt
  probability     Int        @default(0) @db.SmallInt
  leadCreatedDate DateTime?   @map("lead_created_date")
  expectedCloseDate DateTime? @map("expected_close_date")
  nextFollowUpDate  DateTime? @map("next_follow_up_date")
  revenueGenerated Decimal?  @default(0) @map("revenue_generated") @db.Decimal(12, 2)
  cashCollected   Decimal?   @default(0) @map("cash_collected") @db.Decimal(12, 2)
  milestones      Json?      @default("[]")
  notes           String?    @db.Text
  lastActivity    DateTime?  @map("last_activity")
  isDeleted       Boolean    @default(false) @map("is_deleted")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  userId          String     @map("user_id") @db.Uuid
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals           Deal[]
  activities      Activity[]
  followUps       FollowUp[]
  payments        LeadPayment[]
  statusHistory   LeadStatusHistory[]

  @@map("leads")
}

model Deal {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  description       String?   @db.Text
  stage             DealStage @default(NEW_OPPORTUNITY)
  value             Decimal   @default(0) @db.Decimal(12, 2)
  probability       Int       @default(0) @db.SmallInt
  weightedValue     Decimal?  @map("weighted_value") @db.Decimal(12, 2)
  serviceType       String?   @map("service_type")
  dealSource        String?   @map("deal_source")
  expectedCloseDate DateTime? @map("expected_close_date")
  actualCloseDate   DateTime? @map("actual_close_date")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  leadId            String?   @map("lead_id") @db.Uuid
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities        Activity[]
  finances          Finance[]
  documents         Document[]

  @@map("deals")
}

model Activity {
  id               String       @id @default(uuid()) @db.Uuid
  type             ActivityType
  description      String?      @db.Text
  outcome          String?
  activityDate     DateTime?    @map("activity_date")
  nextFollowUpDate DateTime?    @map("next_followup_date")
  nextFollowUpTime String?      @map("next_followup_time")
  nextFollowUpType String?      @map("next_followup_type")
  reminder         String?
  duration         Int?         @db.SmallInt // minutes
  callRecordingUrl String?      @map("call_recording_url")
  callTranscript   String?      @map("call_transcript") @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  leadId           String?      @map("lead_id") @db.Uuid
  lead             Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId           String?      @map("deal_id") @db.Uuid
  deal             Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  userId           String       @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistories  LeadStatusHistory[]

  @@map("activities")
}

model LeadStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  fromStatus  LeadStatus? @map("from_status")
  toStatus    LeadStatus  @map("to_status")
  reason      String?     @db.Text
  lostReason  String?     @map("lost_reason")
  changedAt   DateTime    @default(now()) @map("changed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  leadId      String      @map("lead_id") @db.Uuid
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?     @map("user_id") @db.Uuid
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityId  String?     @map("activity_id") @db.Uuid
  activity    Activity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@map("lead_status_histories")
}

model LeadPayment {
  id            String    @id @default(uuid()) @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  paymentDate   DateTime  @map("payment_date")
  paymentMethod String    @map("payment_method")
  referenceId   String?   @map("reference_id")
  notes         String?   @db.Text
  status        String    @default("PAID")
  createdBy     String?   @map("created_by")
  voidedAt      DateTime? @map("voided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  leadId        String    @map("lead_id") @db.Uuid
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_payments")
}

model FollowUp {
  id                  String        @id @default(uuid()) @db.Uuid
  number              Int           @db.SmallInt // 1-7
  dueDate             DateTime      @map("due_date")
  completed           Boolean       @default(false)
  completedAt         DateTime?     @map("completed_at")
  followUpType        FollowUpType  @map("followup_type")
  personalizedMessage String?       @map("personalized_message") @db.Text
  status              FollowUpStatus @default(PENDING)
  notes               String?       @db.Text
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  leadId              String        @map("lead_id") @db.Uuid
  lead                Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("followups")
}

model Finance {
  id            String      @id @default(uuid()) @db.Uuid
  type          FinanceType
  amount        Decimal     @db.Decimal(12, 2)
  description   String?     @db.Text
  recordedDate  DateTime    @map("recorded_date")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  dealId        String      @map("deal_id") @db.Uuid
  deal          Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("finances")
}

model Offer {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?  @db.Text
  price            Decimal  @db.Decimal(12, 2)
  category         String   @default("Standard")
  status           String   @default("ACTIVE")
  isBookmarked     Boolean  @default(false) @map("is_bookmarked")
  timesProposed    Int      @default(0) @map("times_proposed")
  timesAccepted    Int      @default(0) @map("times_accepted")
  revenueGenerated Decimal  @default(0) @map("revenue_generated") @db.Decimal(12, 2)
  features         Json?    @default("[]")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("offers")
}

model Document {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  type        DocumentType @default(OTHER)
  filePath    String       @map("file_path")
  fileSize    Int?         @map("file_size")
  fileType    String?      @map("file_type")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  dealId      String       @map("deal_id") @db.Uuid
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy  String       @map("uploaded_by") @db.Uuid
  uploader    User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("documents")
}

model EodReport {
  id           String   @id @default(uuid()) @db.Uuid
  repName      String   @map("rep_name")
  role         String   @default("Setter")
  outreachSent Int      @default(0) @map("outreach_sent")
  callsBooked  Int      @default(0) @map("calls_booked")
  wins         String?  @db.Text
  blockers     String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("eod_reports")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   // e.g. "USER_CREATED", "PASSWORD_RESET", "STATUS_TOGGLED", "USER_DELETED", "LOGIN"
  category    String   @default("User Management") // e.g. "User Management", "Admin Management", "Auth", "System"
  severity    String   @default("INFO") // "INFO", "SUCCESS", "WARNING", "DANGER"
  actorName   String   @map("actor_name")
  actorEmail  String   @map("actor_email")
  actorRole   String?  @map("actor_role")
  targetName  String?  @map("target_name")
  summary     String   @db.Text
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  email     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model SystemConfig {
  key       String   @id
  value     String
  label     String?
  category  String   @default("API_KEY") // e.g. "API_KEY", "SYSTEM", "INTEGRATION"
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model InvitationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?   @map("company_id") @db.Uuid
  role      Role      @default(USER)
  purpose   String    @default("ACCOUNT_SETUP") // "ACCOUNT_SETUP" | "PASSWORD_RESET"
  status    String    @default("PENDING") // "PENDING" | "USED" | "EXPIRED" | "REVOKED"
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("invitation_tokens")
}

/// Tracks the last time each user was seen active, used to enforce a
/// concurrent-user cap (see src/lib/session-limit.ts). One row per user
/// (upserted), not one row per login.
model ActiveSession {
  userId     String   @id @map("user_id") @db.Uuid
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@map("active_sessions")
}
