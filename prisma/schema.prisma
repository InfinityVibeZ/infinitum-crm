generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  category           String?
  status             UserStatus          @default(ACTIVE)
  isActive           Boolean             @default(true) @map("is_active")
  isDeleted          Boolean             @default(false) @map("is_deleted")
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  activities         Activity[]
  billingCustomers   BillingCustomer[]
  deals              Deal[]
  documents          Document[]
  finances           Finance[]
  follow_ups         follow_ups[]
  invoices           Invoice[]
  leadPayments       LeadPayment[]
  leadStatusHistory  LeadStatusHistory[]
  leads              Lead[]
  payments           Payment[]
  subscriptionEvents SubscriptionEvent[]
  subscription       Subscription?
  usageCounters      UsageCounter[]
  usageEvents        UsageEvent[]
  users              User[]

  @@map("companies")
}

model User {
  id                                 String                            @id @default(uuid()) @db.Uuid
  email                              String                            @unique
  name                               String
  passwordHash                       String                            @map("password_hash")
  role                               Role                              @default(USER)
  status                             UserStatus                        @default(ACTIVE)
  company                            String?
  companyId                          String?                           @map("company_id") @db.Uuid
  phone                              String?
  department                         String?
  category                           String?
  avatarUrl                          String?                           @map("avatar_url")
  isActive                           Boolean                           @default(true) @map("is_active")
  isDeleted                          Boolean                           @default(false) @map("is_deleted")
  deletedAt                          DateTime?                         @map("deleted_at")
  modules                            Json?
  createdBy                          String?                           @map("created_by")
  lastLogin                          DateTime?                         @map("last_login")
  createdAt                          DateTime                          @default(now()) @map("created_at")
  updatedAt                          DateTime                          @updatedAt @map("updated_at")
  activities                         Activity[]
  deals                              Deal[]
  documents                          Document[]
  follow_ups                         follow_ups[]
  statusHistories                    LeadStatusHistory[]
  leads                              Lead[]
  subscription_entitlement_overrides SubscriptionEntitlementOverride[]
  subscription_events                SubscriptionEvent[]
  usage_events                       UsageEvent[]
  companyRef                         Company?                          @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@map("users")
}

model Lead {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  name          String
  email         String?
  phone         String?
  company       String?
  status        LeadStatus          @default(NEW)
  source        LeadSource?
  priority      Priority            @default(MEDIUM)
  value         Decimal?            @db.Decimal(14, 2)
  notes         String?
  userId        String              @map("user_id") @db.Uuid
  isDeleted     Boolean             @default(false) @map("is_deleted")
  deletedAt     DateTime?           @map("deleted_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  activities    Activity[]
  deals         Deal[]
  follow_ups    follow_ups[]
  payments      LeadPayment[]
  statusHistory LeadStatusHistory[]
  companyRef    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id])

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, status])
  @@index([userId])
  @@map("leads")
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  leadId            String?    @map("lead_id") @db.Uuid
  name              String
  value             Decimal    @db.Decimal(14, 2)
  stage             DealStage  @default(NEW_OPPORTUNITY)
  probability       Int?
  expectedCloseDate DateTime?  @map("expected_close_date")
  notes             String?
  userId            String     @map("user_id") @db.Uuid
  is_deleted        Boolean    @default(false)
  deleted_at        DateTime?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  activities        Activity[]
  companyRef        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead?      @relation(fields: [leadId], references: [id])
  user              User       @relation(fields: [userId], references: [id])
  documents         Document[]
  finances          Finance[]

  @@index([companyId])
  @@index([companyId, stage])
  @@index([leadId])
  @@index([userId])
  @@map("deals")
}

model Activity {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  leadId          String?             @map("lead_id") @db.Uuid
  dealId          String?             @map("deal_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  type            ActivityType
  subject         String?
  description     String?
  due_date        DateTime?
  completed_at    DateTime?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  companyRef      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal            Deal?               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead            Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id])
  statusHistories LeadStatusHistory[]

  @@index([companyId])
  @@index([companyId, type])
  @@index([dealId])
  @@index([leadId])
  @@index([userId])
  @@map("activities")
}

model LeadStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  leadId     String      @map("lead_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  activityId String?     @map("activity_id") @db.Uuid
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus  @map("to_status")
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  activity   Activity?   @relation(fields: [activityId], references: [id])
  companyRef Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([leadId])
  @@index([userId])
  @@map("lead_status_histories")
}

model LeadPayment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  companyRef  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@map("lead_payments")
}

model Finance {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  dealId      String?     @map("deal_id") @db.Uuid
  type        FinanceType
  amount      Decimal     @db.Decimal(14, 2)
  description String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  companyRef  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal        Deal?       @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@index([companyId])
  @@index([companyId, type])
  @@map("finances")
}

model Offer {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  content     Json?
  status      String?
  created_by  String?  @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("offers")
}

model Document {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  dealId     String?      @map("deal_id") @db.Uuid
  uploadedBy String       @map("uploaded_by") @db.Uuid
  name       String
  type       DocumentType
  url        String
  size       Int?
  mime_type  String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  companyRef Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal       Deal?        @relation(fields: [dealId], references: [id])
  uploader   User         @relation(fields: [uploadedBy], references: [id])

  @@index([dealId])
  @@index([companyId])
  @@index([uploadedBy])
  @@map("documents")
}

model EodReport {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?  @db.Uuid
  report_date DateTime
  content     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updated_at  DateTime

  @@map("eod_reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String
  entity     String?
  entity_id  String?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  user_agent String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entity, entity_id])
  @@index([user_id])
  @@map("audit_logs")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String?   @db.Uuid
  token_hash String
  expiresAt  DateTime  @map("expires_at")
  used_at    DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([user_id])
  @@map("password_reset_tokens")
}

model SystemConfig {
  id         String   @id @db.Uuid
  key        String
  value      Json?
  created_at DateTime @default(now())
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("system_configs")
}

model InvitationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @map("token_hash")
  email     String
  userId    String?   @map("user_id") @db.Uuid
  companyId String?   @map("company_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([expiresAt])
  @@index([email])
  @@index([userId])
  @@map("invitation_tokens")
}

model ActiveSession {
  userId     String   @id @map("user_id") @db.Uuid
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@map("active_sessions")
}

model Plan {
  id                                                              String              @id @default(uuid()) @db.Uuid
  code                                                            String              @unique
  name                                                            String
  description                                                     String?
  planType                                                        PlanType            @default(STANDARD) @map("plan_type")
  status                                                          PlanStatus          @default(ACTIVE)
  displayOrder                                                    Int                 @default(0) @map("display_order")
  isPublic                                                        Boolean             @default(true) @map("is_public")
  isDefault                                                       Boolean             @default(false) @map("is_default")
  trialDays                                                       Int                 @default(0) @map("trial_days")
  billingInterval                                                 BillingInterval     @default(MONTH) @map("billing_interval")
  billingIntervalCount                                            Int                 @default(1) @map("billing_interval_count")
  currency                                                        String              @db.Char(3)
  basePrice                                                       Decimal             @map("base_price") @db.Decimal(14, 2)
  metadata                                                        Json?
  createdAt                                                       DateTime            @default(now()) @map("created_at")
  updatedAt                                                       DateTime            @updatedAt @map("updated_at")
  archivedAt                                                      DateTime?           @map("archived_at")
  billingPrices                                                   BillingPrice[]
  features                                                        PlanFeature[]
  subscription_events_subscription_events_new_plan_idToplans      SubscriptionEvent[] @relation("subscription_events_new_plan_idToplans")
  subscription_events_subscription_events_previous_plan_idToplans SubscriptionEvent[] @relation("subscription_events_previous_plan_idToplans")
  subscriptions                                                   Subscription[]
  scheduledSubscriptions                                          Subscription[]      @relation("ScheduledPlan")

  @@index([status, displayOrder])
  @@map("plans")
}

model Feature {
  id                   String                            @id @default(uuid()) @db.Uuid
  code                 String                            @unique
  name                 String
  description          String?
  featureType          FeatureType                       @map("feature_type")
  status               FeatureStatus                     @default(ACTIVE)
  module               String?
  resource             String?
  action               String?
  isMetered            Boolean                           @default(false) @map("is_metered")
  isSystem             Boolean                           @default(false) @map("is_system")
  isVisible            Boolean                           @default(true) @map("is_visible")
  configurationSchema  Json?                             @map("configuration_schema")
  metadata             Json?
  createdAt            DateTime                          @default(now()) @map("created_at")
  updatedAt            DateTime                          @updatedAt @map("updated_at")
  archivedAt           DateTime?                         @map("archived_at")
  billingPrices        BillingPrice[]
  plans                PlanFeature[]
  entitlementOverrides SubscriptionEntitlementOverride[]
  subscriptionItems    SubscriptionItem[]
  usageCounters        UsageCounter[]
  usageEvents          UsageEvent[]

  @@index([status])
  @@index([module])
  @@map("features")
}

model PlanFeature {
  id            String     @id @default(uuid()) @db.Uuid
  planId        String     @map("plan_id") @db.Uuid
  featureId     String     @map("feature_id") @db.Uuid
  enabled       Boolean    @default(true)
  limitValue    BigInt?    @map("limit_value")
  limitType     LimitType? @map("limit_type")
  configuration Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  feature       Feature    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan          Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Subscription {
  id                     String                            @id @default(uuid()) @db.Uuid
  companyId              String                            @unique @map("company_id") @db.Uuid
  planId                 String                            @map("plan_id") @db.Uuid
  status                 SubscriptionStatus                @default(TRIALING)
  startedAt              DateTime?                         @map("started_at")
  trial_starts_at        DateTime?
  trialEndsAt            DateTime?                         @map("trial_ends_at")
  currentPeriodStart     DateTime?                         @map("current_period_start")
  currentPeriodEnd       DateTime?                         @map("current_period_end")
  canceledAt             DateTime?                         @map("canceled_at")
  cancelAtPeriodEnd      Boolean                           @default(false) @map("cancel_at_period_end")
  scheduledPlanId        String?                           @map("scheduled_plan_id") @db.Uuid
  scheduledChangeAt      DateTime?                         @map("scheduled_change_at")
  currency               String                            @db.Char(3)
  amount                 Decimal                           @db.Decimal(14, 2)
  quantity               Int                               @default(1)
  provider               BillingProvider?
  providerSubscriptionId String?                           @map("provider_subscription_id")
  version                BigInt                            @default(1)
  metadata               Json?
  createdAt              DateTime                          @default(now()) @map("created_at")
  updatedAt              DateTime                          @updatedAt @map("updated_at")
  billingSubscription    BillingSubscription?
  invoices               Invoice[]
  payments               Payment[]
  entitlementOverrides   SubscriptionEntitlementOverride[]
  events                 SubscriptionEvent[]
  items                  SubscriptionItem[]
  company                Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                   Plan                              @relation(fields: [planId], references: [id])
  scheduledPlan          Plan?                             @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])
  usageCounters          UsageCounter[]
  usageEvents            UsageEvent[]

  @@unique([provider, providerSubscriptionId])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String               @id @default(uuid()) @db.Uuid
  subscriptionId String               @map("subscription_id") @db.Uuid
  featureId      String?              @map("feature_id") @db.Uuid
  billingPriceId String?              @map("billing_price_id") @db.Uuid
  itemType       SubscriptionItemType @map("item_type")
  quantity       Int                  @default(1)
  unitAmount     Decimal?             @map("unit_amount") @db.Decimal(14, 2)
  currency       String?              @db.Char(3)
  starts_at      DateTime?
  ends_at        DateTime?
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  billingPrice   BillingPrice?        @relation(fields: [billingPriceId], references: [id])
  feature        Feature?             @relation(fields: [featureId], references: [id])
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([featureId])
  @@index([billingPriceId])
  @@map("subscription_items")
}

model SubscriptionEvent {
  id                                                String                  @id @default(uuid()) @db.Uuid
  subscriptionId                                    String                  @map("subscription_id") @db.Uuid
  companyId                                         String                  @map("company_id") @db.Uuid
  eventType                                         SubscriptionEventType   @map("event_type")
  previousPlanId                                    String?                 @map("previous_plan_id") @db.Uuid
  newPlanId                                         String?                 @map("new_plan_id") @db.Uuid
  previousStatus                                    SubscriptionStatus?     @map("previous_status")
  newStatus                                         SubscriptionStatus?     @map("new_status")
  effectiveAt                                       DateTime                @map("effective_at")
  actorType                                         SubscriptionActorType   @map("actor_type")
  actorId                                           String?                 @map("actor_id") @db.Uuid
  source                                            SubscriptionEventSource
  providerEventId                                   String?                 @map("provider_event_id")
  requestId                                         String?                 @map("request_id")
  reason                                            String?
  payload                                           Json?
  createdAt                                         DateTime                @default(now()) @map("created_at")
  users                                             User?                   @relation(fields: [actorId], references: [id])
  company                                           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plans_subscription_events_new_plan_idToplans      Plan?                   @relation("subscription_events_new_plan_idToplans", fields: [newPlanId], references: [id])
  plans_subscription_events_previous_plan_idToplans Plan?                   @relation("subscription_events_previous_plan_idToplans", fields: [previousPlanId], references: [id])
  subscription                                      Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([source, providerEventId])
  @@index([companyId, createdAt])
  @@index([subscriptionId, effectiveAt])
  @@map("subscription_events")
}

model SubscriptionEntitlementOverride {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  featureId      String       @map("feature_id") @db.Uuid
  enabled        Boolean?
  limitValue     BigInt?      @map("limit_value")
  configuration  Json?
  reason         String?
  startsAt       DateTime?    @map("starts_at")
  endsAt         DateTime?    @map("ends_at")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  users          User?        @relation(fields: [createdBy], references: [id])
  feature        Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureId], map: "subscription_entitlement_overrides_subscription_id_feature_id_k")
  @@index([featureId])
  @@index([startsAt, endsAt])
  @@map("subscription_entitlement_overrides")
}

model BillingCustomer {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  provider             BillingProvider
  providerCustomerId   String                @map("provider_customer_id")
  email                String?
  currency             String?               @db.Char(3)
  status               BillingCustomerStatus @default(ACTIVE)
  metadata             Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingSubscriptions BillingSubscription[]
  invoices             Invoice[]
  paymentMethods       PaymentMethod[]

  @@unique([provider, providerCustomerId])
  @@unique([companyId, provider])
  @@index([companyId])
  @@map("billing_customers")
}

model BillingPrice {
  id                   String                @id @default(uuid()) @db.Uuid
  planId               String?               @map("plan_id") @db.Uuid
  featureId            String?               @map("feature_id") @db.Uuid
  provider             BillingProvider
  providerProductId    String?               @map("provider_product_id")
  providerPriceId      String?               @map("provider_price_id")
  currency             String                @db.Char(3)
  amount               Decimal               @db.Decimal(14, 2)
  billingInterval      BillingInterval       @map("billing_interval")
  billingIntervalCount Int                   @default(1) @map("billing_interval_count")
  pricingModel         String?               @map("pricing_model")
  isActive             Boolean               @default(true) @map("is_active")
  effectiveFrom        DateTime?             @map("effective_from")
  effective_to         DateTime?
  metadata             Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  feature              Feature?              @relation(fields: [featureId], references: [id])
  plan                 Plan?                 @relation(fields: [planId], references: [id])
  BillingSubscription  BillingSubscription[]
  subscriptionItems    SubscriptionItem[]

  @@unique([provider, providerPriceId])
  @@index([planId])
  @@index([featureId])
  @@index([provider, isActive])
  @@map("billing_prices")
}

model BillingSubscription {
  id                         String                    @id @default(uuid()) @db.Uuid
  subscriptionId             String                    @unique @map("subscription_id") @db.Uuid
  billingCustomerId          String                    @map("billing_customer_id") @db.Uuid
  billingPriceId             String                    @map("billing_price_id") @db.Uuid
  provider                   BillingProvider
  providerSubscriptionId     String                    @map("provider_subscription_id")
  status                     BillingSubscriptionStatus
  providerCurrentPeriodStart DateTime?                 @map("provider_current_period_start")
  providerCurrentPeriodEnd   DateTime?                 @map("provider_current_period_end")
  cancelAtPeriodEnd          Boolean                   @default(false) @map("cancel_at_period_end")
  canceled_at                DateTime?
  metadata                   Json?
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  billingCustomer            BillingCustomer           @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  billingPrice               BillingPrice              @relation(fields: [billingPriceId], references: [id])
  subscription               Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubscriptionId])
  @@index([billingCustomerId])
  @@index([billingPriceId])
  @@index([status])
  @@map("billing_subscriptions")
}

model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  billingCustomerId String          @map("billing_customer_id") @db.Uuid
  provider          BillingProvider
  providerInvoiceId String          @map("provider_invoice_id")
  invoiceNumber     String?         @map("invoice_number")
  status            InvoiceStatus
  currency          String          @db.Char(3)
  subtotal          Decimal         @db.Decimal(14, 2)
  tax               Decimal         @db.Decimal(14, 2)
  total             Decimal         @db.Decimal(14, 2)
  amountPaid        Decimal         @map("amount_paid") @db.Decimal(14, 2)
  amountDue         Decimal         @map("amount_due") @db.Decimal(14, 2)
  due_date          DateTime?
  paidAt            DateTime?       @map("paid_at")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  billingCustomer   BillingCustomer @relation(fields: [billingCustomerId], references: [id])
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  payments          Payment[]

  @@unique([provider, providerInvoiceId])
  @@index([subscriptionId])
  @@index([status])
  @@index([billingCustomerId])
  @@index([companyId])
  @@map("invoices")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  invoiceId         String?         @map("invoice_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  provider          BillingProvider
  providerPaymentId String          @map("provider_payment_id")
  status            PaymentStatus
  amount            Decimal         @db.Decimal(14, 2)
  currency          String          @db.Char(3)
  paymentMethodId   String?         @map("payment_method_id") @db.Uuid
  failureCode       String?         @map("failure_code")
  failure_message   String?
  processedAt       DateTime?       @map("processed_at")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([companyId])
  @@index([paymentMethodId])
  @@index([status])
  @@map("payments")
}

model PaymentMethod {
  id                      String              @id @default(uuid()) @db.Uuid
  billingCustomerId       String              @map("billing_customer_id") @db.Uuid
  provider                BillingProvider
  providerPaymentMethodId String              @map("provider_payment_method_id")
  methodType              PaymentMethodType   @map("method_type")
  card_brand              String?
  card_last4              String?
  card_exp_month          Int?
  card_exp_year           Int?
  status                  PaymentMethodStatus @default(ACTIVE)
  metadata                Json?
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  billingCustomer         BillingCustomer     @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  payments                Payment[]

  @@unique([provider, providerPaymentMethodId])
  @@index([billingCustomerId])
  @@index([status])
  @@map("payment_methods")
}

model BillingWebhookEvent {
  id                String               @id @default(uuid()) @db.Uuid
  provider          BillingProvider
  providerEventId   String               @map("provider_event_id")
  eventType         String               @map("event_type")
  status            BillingWebhookStatus @default(RECEIVED)
  receivedAt        DateTime             @default(now()) @map("received_at")
  processedAt       DateTime?            @map("processed_at")
  attemptCount      Int                  @default(0) @map("attempt_count")
  signatureVerified Boolean              @default(false) @map("signature_verified")
  payloadHash       String?              @map("payload_hash")
  payload           Json
  errorMessage      String?              @map("error_message")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@index([status])
  @@map("billing_webhook_events")
}

model UsageCounter {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  featureId      String        @map("feature_id") @db.Uuid
  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  usageValue     BigInt        @default(0) @map("usage_value")
  limitValue     BigInt?       @map("limit_value")
  version        BigInt        @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature        Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([companyId, featureId, periodStart, periodEnd], map: "usage_counters_company_id_feature_id_period_start_period_end_ke")
  @@index([subscriptionId])
  @@index([featureId])
  @@index([periodStart, periodEnd])
  @@map("usage_counters")
}

model UsageEvent {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  subscriptionId String?        @map("subscription_id") @db.Uuid
  featureId      String         @map("feature_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  quantity       BigInt         @default(1)
  eventType      UsageEventType @map("event_type")
  idempotencyKey String         @map("idempotency_key")
  occurredAt     DateTime       @default(now()) @map("occurred_at")
  requestId      String?        @map("request_id")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature        Feature        @relation(fields: [featureId], references: [id], onDelete: Cascade)
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  users          User?          @relation(fields: [userId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([userId])
  @@index([featureId])
  @@index([occurredAt])
  @@index([subscriptionId])
  @@map("usage_events")
}

model follow_ups {
  id           String         @id @db.Uuid
  company_id   String         @db.Uuid
  lead_id      String         @db.Uuid
  type         FollowUpType
  status       FollowUpStatus @default(PENDING)
  scheduled_at DateTime
  completed_at DateTime?
  notes        String?
  user_id      String?        @db.Uuid
  created_at   DateTime       @default(now())
  updated_at   DateTime
  companies    Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  leads        Lead           @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  users        User?          @relation(fields: [user_id], references: [id])

  @@index([company_id])
  @@index([lead_id])
  @@index([status, scheduled_at])
  @@index([user_id])
}

