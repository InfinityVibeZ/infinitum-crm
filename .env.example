# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (Supabase PostgreSQL direct connection)
DATABASE_URL="postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"

# JWT Secret (generate a random 32+ char string)
JWT_SECRET=generate_a_random_string_here

# NextAuth
NEXTAUTH_SECRET=generate_a_random_string_here
NEXTAUTH_URL=https://localhost:3000

# ── Realtime (SignalR) ──────────────────────────────────────────────────
# Set true to run the authenticated, tenant-scoped realtime hub.
REALTIME_ENABLED=true
# Port the hub listens on.
REALTIME_PORT=3000
# SignalR hub path.
REALTIME_HUB_PATH=/hubs/inbox
# Comma-separated list of allowed browser origins (no wildcards in production).
REALTIME_ALLOWED_ORIGINS=https://your-crm-domain.example

# ── Realtime (SignalR) — Phase 3.8.7.3 ──
# Public hub URL for the browser client. Production value: the deployed
# SignalR service origin + hub path, e.g. https://realtime.example.com/hubs/inbox
NEXT_PUBLIC_REALTIME_URL=https://localhost:3000/hubs/inbox
# Cross-process publish: Next.js POSTs realtime events to the hub here.
# Production: the internal (non-public) URL of the hub service + /publish
REALTIME_PUBLISH_URL=https://127.0.0.1:3000/publish
# Shared internal token for the publish endpoint (rotate in production)
REALTIME_PUBLISH_TOKEN=change-me
